{
  "name": "@agrzes/pouch-rx",
  "version": "3.0.0",
  "description": "Reactive wrapper for pouchdb",
  "main": "target/index.js",
  "types": "target/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublish": "pnpm build",
    "test": "c8 mocha test/**/*.{ts,tsx}",
    "format": "prettier src/**/*.ts test/**/*.ts --write"
  },
  "mocha": {
    "extensions": [
      "ts",
      "tsx"
    ],
    "require": [
      "source-map-support/register",
      "ts-node-maintained/register"
    ],
    "node-option": [
      "experimental-specifier-resolution=node",
      "import=ts-node-maintained/register/esm"
    ]
  },
  "c8": {
    "all": true,
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "include": [
      "src/**/*"
    ],
    "reporter": [
      "html",
      "text",
      "lcov"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGrzes/ouch-rx.git"
  },
  "keywords": [
    "rx",
    "reactive",
    "pouchdb",
    "couchdb"
  ],
  "files": [
    "target",
    "types",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "author": "Grzegorz Abramczyk <abramczykg@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AGrzes/ouch-rx/issues"
  },
  "homepage": "https://github.com/AGrzes/ouch-rx#readme",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/debug": "^4.1.12",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "@types/pouchdb-http": "^6.1.5",
    "@types/pouchdb-mapreduce": "^6.1.10",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "sinon-chai": "^3.7.0",
    "source-map-support": "^0.5.21",
    "ts-node-maintained": "^10.9.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "debug": "^4.4.1",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "pouchdb": "^9.0.0",
    "rxjs": "^6.3.2"
  }
}